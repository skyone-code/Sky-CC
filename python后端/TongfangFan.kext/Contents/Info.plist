			<string>com.macconsole.TongfangFan</string>
			<key>IOClass</key>
			<string>TongfangFanDriver</string>
			<key>IONameMatch</key>
			<string>PNP0C14</string>
			<key>IOProviderClass</key>
			<string>IOACPIPlatformDevice</string>
			<!-- v1.0.4 关键修复：独立匹配类别。
			     无此键时与 VoodooWMI 同处默认类别，同一 provider
			     每个类别只挂一个驱动 —— VoodooWMI 先到，我方永远被丢弃，
			     这就是「kext 在内核、驱动永不出现」的根因。
			     独立类别允许与 VoodooWMI 并排挂载同一 WMI 设备。 -->
			<key>IOMatchCategory</key>
			<string>TongfangFan</string>
			<!-- 调试时置 true 可见全部 _WDG 块日志 -->
			<key>DebugMode</key>
			<false/>
