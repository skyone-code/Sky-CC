#!/bin/zsh
# ============================================================================
# Mac控制台.app 启动器
#
# 职责（按顺序）：
#   1. 选一个 python3（/usr/bin → /usr/local → /opt/homebrew → PATH）
#   2. 端口被占 → 停掉旧服务（保证跑的是本 app 内置的代码，和 .command 版同哲学）
#   3. 安装/刷新两个用户态守护（幂等）：
#        com.user.auxbright        亮度守护（auxbright v4 watch：保持面板 PWM 模式，
#                                   亮度由 macOS 原生链路驱动）
#        com.macconsole.rgbrestore 键盘灯效开机恢复
#      并让位已废弃的 com.user.auxsmooth（改名 .disabled，可随时改回）
#   4. kext 检测：未加载则尝试提权自动安装（首次运行弹系统密码框；
#      失败不阻塞——app 以降级模式启动并提示用户跑「安装散热控制.command」）
#   5. 后台起 server.py，等就绪后 open 浏览器
#   6. 前台 wait：app 的存活周期 = 服务的存活周期；Dock 图标右键退出 /
#      Cmd+Q 发 SIGTERM → trap 清理服务进程
#
# 日志：~/Library/Logs/MacConsole.log
# ============================================================================
set -u
CONTENTS="$(cd "$(dirname "$0")/.." && pwd)"
RES="$CONTENTS/Resources"
STATE_DIR="$HOME/Library/Application Support/MacConsole"
LOG_DIR="$HOME/Library/Logs"
LOG="$LOG_DIR/MacConsole.log"
PORT="${MACCONSOLE_PORT:-8787}"
URL="http://127.0.0.1:$PORT"

mkdir -p "$STATE_DIR" "$LOG_DIR"

log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >>"$LOG"; }

kext_running() { ioreg -r -c TongfangFanDriver 2>/dev/null | grep -q TongfangFanDriver; }

# ---------- 1. python3 ----------
PY=""
for c in /usr/bin/python3 /usr/local/bin/python3 /opt/homebrew/bin/python3; do
  [[ -x "$c" ]] && { PY="$c"; break; }
done
[[ -z "$PY" ]] && PY="$(command -v python3 2>/dev/null || true)"
if [[ -z "$PY" ]]; then
  /usr/bin/osascript -e 'display alert "Mac控制台" message "未找到 python3。请先安装 Xcode 命令行工具：xcode-select --install"' >/dev/null 2>&1 &
  log "致命错误：未找到 python3"
  exit 1
fi
log "python: $PY ($("$PY" -V 2>&1))"

# ---------- 2. 端口被占 → 停旧服务 ----------
if curl -s -o /dev/null --noproxy '*' --max-time 2 "$URL/api/overview" 2>/dev/null; then
  log "端口 $PORT 被旧服务占用，停止它以保证运行本 app 内置代码"
  PIDS="$(lsof -ti tcp:$PORT 2>/dev/null || true)"
  [[ -z "$PIDS" ]] && PIDS="$(pgrep -f "Mac控制台.*/server\.py" 2>/dev/null || true)"
  [[ -z "$PIDS" ]] && PIDS="$(pgrep -f "MacConsole/server\.py" 2>/dev/null || true)"
  if [[ -n "$PIDS" ]]; then
    echo "$PIDS" | tr ' ' '\n' | while read -r p; do [[ -n "$p" ]] && kill "$p" 2>/dev/null; done
    for _ in 1 2 3 4 5 6; do
      curl -s -o /dev/null --noproxy '*' --max-time 1 "$URL/api/overview" 2>/dev/null || break
      sleep 0.5
    done
  fi
  if curl -s -o /dev/null --noproxy '*' --max-time 1 "$URL/api/overview" 2>/dev/null; then
    PIDS="$(lsof -ti tcp:$PORT 2>/dev/null || true)"
    [[ -n "$PIDS" ]] && echo "$PIDS" | tr ' ' '\n' | while read -r p; do [[ -n "$p" ]] && kill -9 "$p" 2>/dev/null; done
    sleep 0.5
  fi
fi

# ---------- 3. 用户态守护（幂等；失败不阻塞主程序） ----------
"$RES/scripts/ensure-agents.sh" >>"$LOG" 2>&1 || log "守护安装脚本失败（不影响主程序）"

# ---------- 4. kext 检测 / 首次运行自动安装 ----------
if kext_running; then
  log "散热内核扩展已加载"
else
  log "散热内核扩展未加载 → 尝试提权自动安装（可能弹出系统密码框）"
  KEXT_TAG="$STATE_DIR/.kext-install.$$"
  rm -f "$KEXT_TAG"
  (
    osascript -e "do shell script \"bash '$RES/scripts/install-kext.sh'\" with administrator privileges" >/dev/null 2>&1
    echo "$?" >"$KEXT_TAG"
  ) &
  KEXT_JOB=$!
  # 最多等 90 秒（够输密码）；超时不杀 osascript，app 照常启动
  for _ in $(seq 1 90); do
    [[ -s "$KEXT_TAG" ]] && break
    kill -0 "$KEXT_JOB" 2>/dev/null || break
    sleep 1
  done
  KEXT_RC="$(cat "$KEXT_TAG" 2>/dev/null || echo 124)"
  rm -f "$KEXT_TAG"
  log "kext 自动安装结束 rc=$KEXT_RC（详见 /tmp/macconsole-kext-install.log）"
  sleep 1
  if kext_running; then
    log "散热内核扩展安装成功"
  else
    log "散热内核扩展未安装（app 以降级模式启动）"
    /usr/bin/osascript -e 'display alert "Mac控制台" message "散热内核扩展尚未安装：风扇、整机性能档、充电阈值、海岸灯等功能将暂时不可用。请双击随附的「安装散热控制.command」完成一次性安装，然后重新打开 Mac控制台。"' >/dev/null 2>&1 &
  fi
fi

# ---------- 5. 起服务 ----------
log "启动服务: $RES/server.py (port $PORT)"
"$PY" "$RES/server.py" >>"$LOG" 2>&1 &
SRV=$!
echo "$SRV" >"$STATE_DIR/app.server.pid"

cleanup() {
  if kill -0 "$SRV" 2>/dev/null; then
    kill "$SRV" 2>/dev/null
    for _ in 1 2 3 4 5; do
      kill -0 "$SRV" 2>/dev/null || break
      sleep 0.2
    done
    kill -0 "$SRV" 2>/dev/null && kill -9 "$SRV" 2>/dev/null
    log "服务进程 $SRV 已停止"
  fi
  rm -f "$STATE_DIR/app.server.pid"
}
trap cleanup EXIT
trap 'exit 0' INT TERM

# ---------- 6. 等就绪 + 开浏览器 ----------
READY=0
for _ in $(seq 1 80); do
  if curl -s -o /dev/null --noproxy '*' --max-time 1 "$URL/api/overview" 2>/dev/null; then
    READY=1
    break
  fi
  kill -0 "$SRV" 2>/dev/null || break
  sleep 0.25
done

if [[ "$READY" == "1" ]]; then
  /usr/bin/open "$URL"
  log "已就绪，浏览器已打开: $URL"
else
  log "启动失败，最后 30 行日志："
  tail -30 "$LOG" >>"$LOG" 2>/dev/null
  /usr/bin/osascript -e "display alert \"Mac控制台启动失败\" message \"服务未能在 20 秒内就绪。日志：~/Library/Logs/MacConsole.log\"" >/dev/null 2>&1 &
  sleep 3
  exit 1
fi

# ---------- 7. 前台驻留 ----------
log "app 驻留中（Dock 图标右键 → 退出 可停止服务）"
wait "$SRV"
log "服务进程结束，app 退出"
