#!/bin/sh
# ============================================================================
# Mac控制台安装器 · postinstall（以 root 运行）
#
#   1. 安装 TongfangFan.kext 到 /Library/Extensions + 开机 LaunchDaemon + 立即加载
#      （与桌面版「安装散热控制.command」做同样的事，幂等；加载失败不阻断安装）
#   2. 把 /Applications 下两个 app 属主改为当前登录用户（以后免密码更新）
#
# 日志：/tmp/macconsole-install.log
# ============================================================================
LOG=/tmp/macconsole-install.log
exec >>"$LOG" 2>&1
echo "=== $(date '+%F %T') postinstall 开始 ==="

KEXT_SRC="/Library/Application Support/MacConsole/TongfangFan.kext"
KEXT_DST="/Library/Extensions/TongfangFan.kext"
DAEMON_PLIST="/Library/LaunchDaemons/com.macconsole.TongfangFan.plist"
KEXT_ID="com.macconsole.TongfangFan"

# ---------- 1. kext ----------
if [ -d "$KEXT_SRC" ]; then
    rm -rf "$KEXT_DST"
    cp -R "$KEXT_SRC" "$KEXT_DST"
    chown -R root:wheel "$KEXT_DST"

    cat > "$DAEMON_PLIST" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$KEXT_ID</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/kmutil</string>
		<string>load</string>
		<string>-p</string>
		<string>$KEXT_DST</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/macconsole-fankext.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/macconsole-fankext.log</string>
</dict>
</plist>
EOF
    chown root:wheel "$DAEMON_PLIST"
    chmod 644 "$DAEMON_PLIST"

    if /usr/bin/ioreg -r -c TongfangFanDriver 2>/dev/null | /usr/bin/grep -q TongfangFanDriver; then
        echo "kext 已在运行，跳过加载"
    elif /usr/bin/kmutil load -p "$KEXT_DST" 2>&1; then
        echo "kext 加载命令已执行"
    else
        echo "kext 立即加载失败 —— 重启后由 LaunchDaemon 重试；"
        echo "若系统提示未批准的内核扩展，请到 系统设置→隐私与安全性 点允许后重启"
    fi

    if /usr/bin/ioreg -r -c TongfangFanDriver 2>/dev/null | /usr/bin/grep -q TongfangFanDriver; then
        echo "OK: TongfangFanDriver 已就绪"
    else
        echo "NOTE: TongfangFanDriver 暂未就绪，重启后生效（不影响安装）"
    fi
else
    echo "警告：找不到 $KEXT_SRC，跳过 kext 安装"
fi

# ---------- 2. app 属主改为登录用户 ----------
CONSOLE_USER=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null || echo "")
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    /usr/bin/chown -R "$CONSOLE_USER" "/Applications/Mac控制台.app" 2>/dev/null
    /usr/bin/chown -R "$CONSOLE_USER" "/Applications/Mac控制台开机启动.app" 2>/dev/null
    /usr/bin/chown -R "$CONSOLE_USER" "/Library/Application Support/MacConsole" 2>/dev/null
    echo "app 属主已设为 $CONSOLE_USER"
fi

echo "=== postinstall 完成 ==="
exit 0
